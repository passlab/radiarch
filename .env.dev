# Radiarch TPS — Local Development / Demo Configuration
# Copy to .env:  cp .env.dev .env

# ---- Core ----
RADIARCH_ENVIRONMENT=dev               # "dev" = Celery eager mode (no Redis needed)

# ---- Database ----
# Empty = InMemoryStore (good for local dev)
RADIARCH_DATABASE_URL=

# ---- Celery / Redis ----
RADIARCH_BROKER_URL=memory://
RADIARCH_RESULT_BACKEND=cache+memory://

# ---- Orthanc / PACS ----
RADIARCH_ORTHANC_USE_MOCK=true

# ---- DICOMweb ----
RADIARCH_DICOMWEB_URL=

# ---- Artifacts ----
RADIARCH_ARTIFACT_DIR=./data/artifacts

# ---- Data ----
# Empty = the bundled tests/data/SimpleFantomWithStruct/
RADIARCH_DATA_ROOT=
