+/*
+Beamlet (influence-matrix) mode on the GPU. Replaces Run_simulation_beamlet when MCSQUARE_GPU=1 (3D, sparse dose
+output only). Spots are simulated in groups that fit a dose-memory budget (MCSQUARE_GPU_DOSE_BYTES, default 4 GB):
+each spot of a group has its own dose grid on the device; its primaries are sampled by MCsquare's own
+Generate_PBS_particle from the single-spot plan, Num_Primaries of them as Run_simulation_beamlet counts them. Each
+grid is post-processed as PostProcess_Scoring does and written in the sparse format export_Sparse_image and
+Merge_Sparse_Files produce, straight into the merged Outputs/Sparse_Dose files (no per-spot temporary files).
+*/
+typedef struct { unsigned char *bytes; size_t n, cap; } ByteBuf;
+
+static void bb_put(ByteBuf *b, const void *p, size_t n){
+  if(b->n + n > b->cap){
+    b->cap = (b->n + n) * 2 + 1024;
+    b->bytes = (unsigned char*)realloc(b->bytes, b->cap);
+  }
+  memcpy(b->bytes + b->n, p, n);
+  b->n += n;
+}
+
+void gpu_Run_simulation_beamlet(DATA_config *config, Materials *material, DATA_CT **CT_phases, plan_parameters *plan,
+                                machine_parameters *machine){
+
+  static int Num_call = 0;
+  Num_call++;
+  DATA_CT *ct = CT_phases[0];
+
+  if(config->Simu_4D_Mode != 0 || config->Dose_Sparse_Output != 1 || config->Energy_Sparse_Output || config->LET_Sparse_Output
+     || config->Dose_MHD_Output || config->Dose_ASCII_Output || config->Energy_MHD_Output || config->Energy_ASCII_Output
+     || config->LET_MHD_Output || config->LET_ASCII_Output || config->Compute_DVH || config->Score_PromptGammas
+     || config->Score_LET || config->Independent_scoring_grid){
+    printf("\n ERROR: the GPU prototype's beamlet mode writes sparse dose only (3D, CT grid).\n\n");
+    exit(2);
+  }
+
+  double t0 = now_s();
+  int nspots = config->TotalNbrSpots;
+  int *sb = malloc(nspots * sizeof(int)), *sc = malloc(nspots * sizeof(int)), *sd = malloc(nspots * sizeof(int));
+  int k = 0;
+  for(int b=0; b<plan->NumberOfFields; b++)
+    for(int c=0; c<plan->fields[b].NumberOfControlPoints; c++)
+      for(int d=0; d<plan->fields[b].ControlPoints[c].NbOfScannedSpots; d++){
+        if(k < nspots){ sb[k] = b; sc[k] = c; sd[k] = d; }
+        k++;
+      }
+  if(k != nspots){ printf("\n ERROR: %d spots in the plan, %d expected\n\n", k, nspots); exit(2); }
+
+  long nvox = ct->Nbr_voxels;
+  double budget = getenv("MCSQUARE_GPU_DOSE_BYTES") ? atof(getenv("MCSQUARE_GPU_DOSE_BYTES")) : 4e9;
+  int K = (int)(budget / (4.0 * nvox));
+  if(K < 1) K = 1;
+  if(K > nspots) K = nspots;
+  unsigned long long seed = (config->RNG_Seed != 0) ? (unsigned long long)config->RNG_Seed + 100000ULL * Num_call
+                                                    : (unsigned long long)time(NULL) + Num_call;
+  if(setup_gpu(config, material, ct, seed, 1, K) != 0){ printf("\n ERROR: GPU initialisation failed\n\n"); exit(2); }
+
+  int nthreads = config->Num_Threads;
+  VAR_RND_SEED *streams = (VAR_RND_SEED*)malloc(nthreads * sizeof(VAR_RND_SEED));
+  #if USE_MKL_LIB==0
+    unsigned int *stream_vals = (unsigned int*)malloc(nthreads * sizeof(unsigned int));
+  #endif
+  plan_parameters **beamlets = malloc(nthreads * sizeof(plan_parameters*));
+  for(int t=0; t<nthreads; t++){
+    #if USE_MKL_LIB==0
+      streams[t] = &stream_vals[t];
+    #endif
+    Init_RND(config, &streams[t], t + Num_call*1e5);
+    beamlets[t] = Init_single_spot_plan(plan);
+  }
+
+  // the merged header, as export_Sparse_image writes it for the first spot
+  char header_path[400], bin_path[400], bin_name[200];
+  sprintf(bin_name, "Sparse_Dose%s.bin", config->output_robustness_suffix);
+  sprintf(header_path, "%sSparse_Dose%s.txt", config->Output_Directory, config->output_robustness_suffix);
+  sprintf(bin_path, "%s%s", config->Output_Directory, bin_name);
+  CreateDir(config->Output_Directory);
+  FILE *fh = fopen(header_path, "w");
+  if(fh == NULL){ printf("\n ERROR: cannot write %s\n\n", header_path); exit(2); }
+  fprintf(fh, "# MCsquare sparse matrix format\n");
+  struct tm *date = localtime(&config->timestamp);
+  fprintf(fh, "SimulationDate = %d/%d/%d %d:%d:%d\n", date->tm_year+1900, date->tm_mon+1, date->tm_mday, date->tm_hour, date->tm_min, date->tm_sec);
+  fprintf(fh, "PlanName = %s\n", plan->PlanName);
+  fprintf(fh, "SimulationMode = Beamlet\n");
+  fprintf(fh, "NbrSpots = %u\n", config->TotalNbrSpots);
+  if(config->Robustness_Mode == 1){
+    fprintf(fh, "SimulationMode = Robustness\n");
+    fprintf(fh, "RobustParam_SystematicSetupError = %f %f %f\n", config->Systematic_Setup_Error[0], config->Systematic_Setup_Error[1], config->Systematic_Setup_Error[2]);
+    fprintf(fh, "RobustParam_RandomSetupError = %f %f %f\n", config->Random_Setup_Error[0], config->Random_Setup_Error[1], config->Random_Setup_Error[2]);
+    fprintf(fh, "RobustParam_SystematicRangeError = %f\n", config->Systematic_Range_Error);
+    fprintf(fh, "Scenario_SystematicSetupError = %f %f %f\n", config->Current_Systematic_setup[0], config->Current_Systematic_setup[1], config->Current_Systematic_setup[2]);
+    fprintf(fh, "Scenario_RandomSetupError = %f %f %f\n", config->Current_Random_setup[0], config->Current_Random_setup[1], config->Current_Random_setup[2]);
+    fprintf(fh, "Scenario_SystematicRangeError = %f\n", config->Current_Range_error);
+  }
+  fprintf(fh, "ImageSize = %d %d %d\n", ct->GridSize[0], ct->GridSize[1], ct->GridSize[2]);
+  fprintf(fh, "VoxelSpacing = %f %f %f\n", 10*ct->VoxelLength[0], 10*ct->VoxelLength[1], 10*ct->VoxelLength[2]);
+  fprintf(fh, "Offset = %f %f %f\n", 10*ct->Origin[0], 10*ct->Origin[1], 10*ct->Origin[2]);
+  fprintf(fh, "BinaryFile = %s\n", bin_name);
+  fclose(fh);
+  FILE *fb = fopen(bin_path, "wb");
+  if(fb == NULL){ printf("\n ERROR: cannot write %s\n\n", bin_path); exit(2); }
+
+  unsigned long Nprim = (unsigned long)config->Num_Primaries;
+  long cap_spot = Nprim + 400;
+  float *grid = NULL;
+  if(config->DoseToWater == 1 || config->Dose_Segmentation != 0 || getenv("MCSQUARE_GPU_HOST_POST") != NULL)
+    grid = (float*)malloc((size_t)K * nvox * sizeof(float));
+  float *buf[8];
+  for(int c=0; c<8; c++) buf[c] = (float*)malloc((size_t)K * cap_spot * sizeof(float));
+  int *slot = (int*)malloc((size_t)K * cap_spot * sizeof(int));
+  long *spot_n = malloc(K * sizeof(long));
+  unsigned long *spot_sampled = malloc(K * sizeof(unsigned long));
+  ByteBuf *out = calloc(K, sizeof(ByteBuf));
+  double voxel_volume = (double)ct->VoxelLength[0] * ct->VoxelLength[1] * ct->VoxelLength[2];
+  double t_gen = 0, t_gpu = 0, t_out = 0;
+  long total_primaries = 0;
+  // MCsquare's post-processing on the device unless it needs the materials or the densities
+  int device_post = (config->DoseToWater != 1 && config->Dose_Segmentation == 0);
+  if(getenv("MCSQUARE_GPU_HOST_POST") != NULL) device_post = 0;
+  float *scale = malloc(K * sizeof(float));
+
+  for(int g0=0; g0<nspots; g0+=K){
+    int kk = (nspots - g0 < K) ? nspots - g0 : K;
+    double ta = now_s();
+
+    #pragma omp parallel for num_threads(nthreads) schedule(dynamic,1)
+    for(int j=0; j<kk; j++){
+      int tid = omp_get_thread_num();
+      plan_parameters *Beamlet = beamlets[tid];
+      int sp = g0 + j;
+      Select_spot(plan, Beamlet, sb[sp], sc[sp], sd[sp]);
+      Hadron_buffer local[200];
+      int nl;
+      unsigned long sampled = 0;
+      long m = 0, base = (long)j * cap_spot;
+      while(sampled < Nprim){
+        nl = 0;
+        Generate_PBS_particle(local, &nl, ct->Length, Beamlet, machine, streams[tid], config, material);
+        sampled += VLENGTH;
+        for(int q=0; q<nl; q++){
+          if(local[q].type == Unknown || m >= cap_spot) continue;
+          long at = base + m;
+          buf[0][at] = local[q].x; buf[1][at] = local[q].y; buf[2][at] = local[q].z;
+          buf[3][at] = local[q].u; buf[4][at] = local[q].v; buf[5][at] = local[q].w;
+          buf[6][at] = local[q].T; buf[7][at] = local[q].M;
+          slot[at] = j;
+          m++;
+        }
+      }
+      spot_n[j] = m;
+      spot_sampled[j] = sampled;
+    }
+
+    // compact the group's primaries (spot j's block starts at j * cap_spot)
+    long n = 0;
+    for(int j=0; j<kk; j++){
+      long base = (long)j * cap_spot;
+      if(base != n){
+        for(int c=0; c<8; c++) memmove(buf[c] + n, buf[c] + base, spot_n[j] * sizeof(float));
+        memmove(slot + n, slot + base, spot_n[j] * sizeof(int));
+      }
+      n += spot_n[j];
+    }
+    total_primaries += n;
+    double tb = now_s();
+    t_gen += tb - ta;
+    if(gpu_batch(n, buf[0], buf[1], buf[2], buf[3], buf[4], buf[5], buf[6], buf[7], slot) != 0){
+      printf("\n ERROR: GPU batch failed\n\n"); exit(2);
+    }
+    VAR_SCORING threshold = config->Dose_Sparse_Threshold;
+
+    if(device_post){
+      // post-processing and compaction on the device; the entries come back ordered by spot, then voxel
+      for(int j=0; j<kk; j++) scale[j] = (float)((double)plan->normalization_factor / spot_sampled[j] / voxel_volume);
+      long long *gidx = NULL; float *gval = NULL; long m = 0;
+      if(gpu_group_sparse(kk, scale, threshold, &gidx, &gval, &m) != 0){ printf("\n ERROR: GPU compaction failed\n\n"); exit(2); }
+      double tc = now_s();
+      t_gpu += tc - tb;
+      long *first = malloc((kk + 1) * sizeof(long));
+      long e = 0;
+      for(int j=0; j<=kk; j++){
+        while(e < m && gidx[e] < (long long)j * nvox) e++;
+        first[j] = e;
+      }
+      #pragma omp parallel for num_threads(nthreads) schedule(dynamic,1)
+      for(int j=0; j<kk; j++){
+        int sp = g0 + j;
+        ByteBuf *o = &out[j];
+        o->n = 0;
+        uint32_t nsel = (uint32_t)(first[j+1] - first[j]);
+        bb_put(o, &nsel, sizeof(uint32_t));
+        uint32_t FieldID = (uint32_t)plan->fields[sb[sp]].FieldID;
+        uint32_t CPI = (uint32_t)plan->fields[sb[sp]].ControlPoints[sc[sp]].ControlPointIndex;
+        float SX = (float)plan->fields[sb[sp]].ControlPoints[sc[sp]].spots[sd[sp]].Spot_X;
+        float SY = (float)plan->fields[sb[sp]].ControlPoints[sc[sp]].spots[sd[sp]].Spot_Y;
+        bb_put(o, &FieldID, 4); bb_put(o, &CPI, 4); bb_put(o, &SX, 4); bb_put(o, &SY, 4);
+        long a = first[j];
+        while(a < first[j+1]){
+          long b = a + 1;
+          while(b < first[j+1] && gidx[b] == gidx[b-1] + 1) b++;
+          uint32_t run = (uint32_t)(b - a), start = (uint32_t)(gidx[a] - (long long)j * nvox);
+          bb_put(o, &run, 4); bb_put(o, &start, 4); bb_put(o, gval + a, run * sizeof(float));
+          a = b;
+        }
+      }
+      for(int j=0; j<kk; j++) fwrite(out[j].bytes, 1, out[j].n, fb);
+      free(first); free(gidx); free(gval);
+      t_out += now_s() - tc;
+      continue;
+    }
+
+    if(gpu_group_dose(grid, kk) != 0){ printf("\n ERROR: GPU batch failed\n\n"); exit(2); }
+    double tc = now_s();
+    t_gpu += tc - tb;
+
+    // post-processing (PostProcess_Scoring) and the sparse blocks (export_Sparse_image), one spot per thread
+    #pragma omp parallel for num_threads(nthreads) schedule(dynamic,1)
+    for(int j=0; j<kk; j++){
+      int sp = g0 + j;
+      float *d = grid + (size_t)j * nvox;
+      VAR_COMPUTE norm = plan->normalization_factor;
+      for(long i=0; i<nvox; i++){
+        float v = d[i];
+        if(config->DoseToWater == 1) v /= material[ct->material[i]].SPR;
+        v = v * norm / spot_sampled[j];
+        v *= (v > 0);
+        v = v / voxel_volume;
+        if(config->Dose_Segmentation != 0) v *= (ct->density[i] > config->Segmentation_Density_Threshold);
+        d[i] = v;
+      }
+      uint32_t nsel = 0;
+      for(long i=0; i<nvox; i++) if(d[i] > threshold) nsel++;
+      ByteBuf *o = &out[j];
+      o->n = 0;
+      bb_put(o, &nsel, sizeof(uint32_t));
+      uint32_t FieldID = (uint32_t)plan->fields[sb[sp]].FieldID;
+      uint32_t CPI = (uint32_t)plan->fields[sb[sp]].ControlPoints[sc[sp]].ControlPointIndex;
+      float SX = (float)plan->fields[sb[sp]].ControlPoints[sc[sp]].spots[sd[sp]].Spot_X;
+      float SY = (float)plan->fields[sb[sp]].ControlPoints[sc[sp]].spots[sd[sp]].Spot_Y;
+      bb_put(o, &FieldID, 4); bb_put(o, &CPI, 4); bb_put(o, &SX, 4); bb_put(o, &SY, 4);
+      uint32_t first = 0, run = 0;
+      for(uint32_t i=0; i<(uint32_t)nvox; i++){
+        if(d[i] > threshold){
+          if(run == 0) first = i;
+          run++;
+        }
+        else if(run != 0){
+          bb_put(o, &run, 4); bb_put(o, &first, 4); bb_put(o, d + first, run * sizeof(float));
+          run = 0;
+        }
+      }
+      if(run != 0){ bb_put(o, &run, 4); bb_put(o, &first, 4); bb_put(o, d + first, run * sizeof(float)); }
+    }
+    for(int j=0; j<kk; j++) fwrite(out[j].bytes, 1, out[j].n, fb);
+    t_out += now_s() - tc;
+  }
+  fclose(fb);
+
+  double t_kernel = 0.0;
+  long long steps = 0, nsec = 0, ovf = 0, clamps = 0;
+  gpu_finish(NULL, &t_kernel, &steps, &nsec, &ovf, &clamps);
+  printf("\nGPU prototype, beamlets (%s post-processing): %d spots in groups of %d, %ld primaries; sampling %.3f s, GPU %.3f s (kernels %.3f s),"
+         " post-processing and output %.3f s, total %.3f s; %.3g steps; nuclear %d: %lld secondaries, %lld lost to a full"
+         " stack, %lld angle indices clamped\n", device_post ? "device" : "host", nspots, K, total_primaries, t_gen, t_gpu, t_kernel, t_out, now_s() - t0,
+         (double)steps, config->Simulate_Nuclear_Interactions, nsec, ovf, clamps);
+
+  for(int t=0; t<nthreads; t++) Free_Plan_Parameters(beamlets[t]);
+  for(int j=0; j<K; j++) free(out[j].bytes);
+  for(int c=0; c<8; c++) free(buf[c]);
+  free(out); free(spot_n); free(spot_sampled); free(slot); free(grid); free(scale); free(beamlets); free(streams);
+  free(sb); free(sc); free(sd);
+}
