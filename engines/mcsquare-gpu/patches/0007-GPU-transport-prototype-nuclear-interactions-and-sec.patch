+__device__ __forceinline__ float lin(float x, float x1, float x2, float y1, float y2) {
+  return ((y2 - y1) / (x2 - x1)) * (x - x1) + y1;                                   // Linear_Interpolation
+}
+__device__ __forceinline__ int bsearch_(float value, const float *list, int n) {      // Binary_Search
+  if (n <= 1) return -1;
+  int i = -1, j = n;
+  while (j - i > 1) { int k = (i + j) / 2; if (list[k] < value) i = k; else j = k; }
+  return i;
+}
+__device__ __forceinline__ int seqsearch(float value, const float *list, int n) {    // Sequential_Search
+  if (n <= 1) return -1;
+  int index = 0;
+  while (index < n) { if (value <= list[index]) return index - 1; index++; }
+  return index - 1;
+}
