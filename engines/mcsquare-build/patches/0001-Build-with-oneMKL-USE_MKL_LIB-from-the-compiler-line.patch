--- a/src/include/define.h
+++ b/src/include/define.h
@@ -21,7 +21,9 @@ The MCsquare software is distributed on an "AS IS" BASIS, WITHOUT WARRANTIES OR
 #include <float.h>
 #include <omp.h> 
 
+#ifndef USE_MKL_LIB
 #define USE_MKL_LIB 0
+#endif
 
